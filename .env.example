# Postgres
DATABASE_URL=postgresql://so:so@localhost:5432/so
# Object store (S3 API / MinIO)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=so-datasets
S3_REGION=us-east-1
S3_USE_SSL=false

# Bootstrap admin — CHANGE THIS before exposing the deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Set to 'true' to mark the session cookie Secure (HTTPS-only). Enable in production behind TLS.
COOKIE_SECURE=false
# OIDC/SSO is EXPERIMENTAL. When 'false', SSO logins only succeed for users that already exist;
# set to 'true' to auto-create a local user on first SSO login.
OIDC_AUTO_PROVISION=false
